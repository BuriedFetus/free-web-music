{
  "name": "free-web-music",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/engine",
    "packages/studio",
    "apps/harness"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/harness",
    "build": "npm run build:engine && npm run build -w apps/harness",
    "build:engine": "packages/engine/build.sh",
    "test": "npm run test:engine && vitest run",
    "test:engine": "cargo test --release --manifest-path packages/engine/Cargo.toml",
    "typecheck": "tsc -p packages/studio && tsc -p apps/harness"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
