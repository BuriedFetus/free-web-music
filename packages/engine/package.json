{
  "name": "@fwm/engine",
  "version": "0.1.0",
  "description": "free-web-music audio engine: Rust/WASM devices in an AudioWorklet, plus a small main-thread host",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./web/engine.d.ts",
      "default": "./web/engine.js"
    },
    "./devices/*.json": "./devices/*.json",
    "./worklet": {
      "types": "./web/worklet.d.ts",
      "default": "./web/worklet.js"
    }
  },
  "files": [
    "web",
    "devices"
  ]
}
