{
  "id": "quartz",
  "name": "Quartz",
  "kind": "instrument",
  "version": 1,
  "voices": "8 voices",
  "description": "FM keys: eight voices, two rows of a carrier pushed by its own modulator (Harmonics, Depth, Env: the bark of a struck key; Wave, Pitch, Level), a low-pass filter, Touch (play harder = brighter), amp envelope, stereo Tremolo, Drive.",
  "params": [
    { "id": "w1",     "label": "Wave",      "section": "row1",   "type": "enum", "options": ["Sine", "Warm", "Hollow", "Pulse"], "default": 0 },
    { "id": "pitch1", "label": "Pitch",     "section": "row1",   "type": "enum", "options": ["−1 oct", "0", "+5th", "+1 oct", "+19", "+2 oct"], "default": 1 },
    { "id": "harm1",  "label": "Harmonics", "section": "row1",   "type": "enum", "options": ["½", "1", "2", "3", "4", "5", "7", "9", "14"], "default": 1 },
    { "id": "depth1", "label": "Depth",     "section": "row1",   "type": "float", "default": 0.35, "unit": "",   "map": "sq",  "min": 0, "max": 8 },
    { "id": "env1",   "label": "Env",       "section": "row1",   "type": "float", "default": 0.35, "unit": "s",  "map": "sq",  "min": 0.02, "max": 4 },
    { "id": "lvl1",   "label": "Level",     "section": "row1",   "type": "float", "default": 0.85, "unit": "%",  "map": "lin", "min": 0, "max": 100 },
    { "id": "w2",     "label": "Wave",      "section": "row2",   "type": "enum", "options": ["Sine", "Warm", "Hollow", "Pulse"], "default": 0 },
    { "id": "pitch2", "label": "Pitch",     "section": "row2",   "type": "enum", "options": ["−1 oct", "0", "+5th", "+1 oct", "+19", "+2 oct"], "default": 1 },
    { "id": "harm2",  "label": "Harmonics", "section": "row2",   "type": "enum", "options": ["½", "1", "2", "3", "4", "5", "7", "9", "14"], "default": 8 },
    { "id": "depth2", "label": "Depth",     "section": "row2",   "type": "float", "default": 0.3,  "unit": "",   "map": "sq",  "min": 0, "max": 8 },
    { "id": "env2",   "label": "Env",       "section": "row2",   "type": "float", "default": 0.15, "unit": "s",  "map": "sq",  "min": 0.02, "max": 4 },
    { "id": "lvl2",   "label": "Level",     "section": "row2",   "type": "float", "default": 0.35, "unit": "%",  "map": "lin", "min": 0, "max": 100 },
    { "id": "cut",    "label": "Cutoff",    "section": "filter", "type": "float", "default": 0.85, "unit": "Hz", "map": "exp", "min": 60, "max": 18000 },
    { "id": "res",    "label": "Reso",      "section": "filter", "type": "float", "default": 0.1,  "unit": "%",  "map": "lin", "min": 0, "max": 100 },
    { "id": "touch",  "label": "Touch",     "section": "filter", "type": "float", "default": 0.6,  "unit": "%",  "map": "lin", "min": 0, "max": 100 },
    { "id": "atk",    "label": "Attack",    "section": "amp",    "type": "float", "default": 0,    "unit": "s",  "map": "sq",  "min": 0.001, "max": 4 },
    { "id": "dec",    "label": "Decay",     "section": "amp",    "type": "float", "default": 0.55, "unit": "s",  "map": "sq",  "min": 0.05, "max": 10 },
    { "id": "sus",    "label": "Sustain",   "section": "amp",    "type": "float", "default": 0.2,  "unit": "%",  "map": "lin", "min": 0, "max": 100 },
    { "id": "rel",    "label": "Release",   "section": "amp",    "type": "float", "default": 0.3,  "unit": "s",  "map": "sq",  "min": 0.02, "max": 6 },
    { "id": "trem",   "label": "Tremolo",   "section": "play",   "type": "float", "default": 0.3,  "unit": "%",  "map": "lin", "min": 0, "max": 100 },
    { "id": "trate",  "label": "Speed",     "section": "play",   "type": "float", "default": 0.4,  "unit": "Hz", "map": "exp", "min": 0.5, "max": 9 },
    { "id": "drive",  "label": "Drive",     "section": "play",   "type": "float", "default": 0.15, "unit": "%",  "map": "lin", "min": 0, "max": 100 },
    { "id": "lvl",    "label": "Level",     "section": "play",   "type": "float", "default": 0.7,  "unit": "%",  "map": "lin", "min": 0, "max": 100 }
  ],
  "modSources": [],
  "notes": {
    "values": "Every param is stored normalised 0..1 (enums as their index). map exp = min*(max/min)^v; sq = min + v*v*(max-min).",
    "fm": "Each row: carrier sine whose phase is pushed by a modulator sine at Harmonics × the note; the push (index up to 8 at full Depth) falls to 20% over Env after each strike, is scaled by Touch × velocity, and eases off above middle C."
  }
}
