{
  "id": "garnet",
  "name": "Garnet",
  "kind": "instrument",
  "version": 1,
  "voices": "6 strings",
  "description": "String synth: six modelled strings (pluck position and hardness, sustain, brightness), a guitar body (Nylon, Steel, Hollow) or an electric pickup, and an amp (Drive, Cab, Presence). Notes go to strings the way a guitarist plays them.",
  "params": [
    { "id": "pick",    "label": "Position",  "section": "pick", "type": "float", "default": 0.2,  "unit": "",   "map": "lin", "min": 0, "max": 100 },
    { "id": "hard",    "label": "Pick",      "section": "pick", "type": "float", "default": 0.6,  "unit": "",   "map": "lin", "min": 0, "max": 100 },
    { "id": "sustain", "label": "Sustain",   "section": "pick", "type": "float", "default": 0.55, "unit": "s",  "map": "sq",  "min": 0.35, "max": 7.85 },
    { "id": "bright",  "label": "Bright",    "section": "pick", "type": "float", "default": 0.6,  "unit": "%",  "map": "lin", "min": 0, "max": 100 },
    { "id": "body",    "label": "Body",      "section": "body", "type": "enum", "options": ["Nylon", "Steel", "Hollow", "Electric"], "default": 3 },
    { "id": "reso",    "label": "Resonance", "section": "body", "type": "float", "default": 0.6,  "unit": "%",  "map": "lin", "min": 0, "max": 100 },
    { "id": "tone",    "label": "Tone",      "section": "body", "type": "float", "default": 0.55, "unit": "%",  "map": "lin", "min": 0, "max": 100 },
    { "id": "drive",   "label": "Drive",     "section": "amp",  "type": "float", "default": 0.12, "unit": "%",  "map": "lin", "min": 0, "max": 100 },
    { "id": "cab",     "label": "Cab",       "section": "amp",  "type": "enum", "options": ["Direct", "Combo", "Stack"], "default": 1 },
    { "id": "pres",    "label": "Presence",  "section": "amp",  "type": "float", "default": 0.55, "unit": "dB", "map": "lin", "min": -8, "max": 8 },
    { "id": "lvl",     "label": "Level",     "section": "amp",  "type": "float", "default": 0.75, "unit": "%",  "map": "lin", "min": 0, "max": 100 },
    { "id": "strum",   "label": "Strum",     "section": "play", "type": "float", "default": 0.35, "unit": "ms", "map": "sq",  "min": 6, "max": 66 },
    { "id": "vib",     "label": "Vibrato",   "section": "play", "type": "float", "default": 0,    "unit": "%",  "map": "lin", "min": 0, "max": 100 },
    { "id": "slide",   "label": "Slide",     "section": "play", "type": "float", "default": 0,    "unit": "ms", "map": "sq0", "min": 4, "max": 304 },
    { "id": "mute",    "label": "Palm mute", "section": "play", "type": "enum", "options": ["Off", "On"], "default": 0 },
    { "id": "ring",    "label": "Ring",      "section": "play", "type": "float", "default": 0.5,  "unit": "%",  "map": "lin", "min": 0, "max": 100 }
  ],
  "modSources": [],
  "notes": {
    "values": "Every param is stored normalised 0..1 (enums as their index). map sq = min + v*v*(max-min); sq0 = like sq but v=0 means off.",
    "strings": "Standard tuning E A D G B E. A note ringing on a string is re-plucked there; otherwise the highest free string that can play it (frets 0-19) takes it, so a strum sent low to high lands on the strings a guitarist would use.",
    "ring": "How long a string keeps sounding after its note ends: 0 = damped at once (about 50 ms), 100% = rings out by Sustain.",
    "slide": "Off by default. When on, a legato note within an octave glides the held string instead of plucking another (for lead lines).",
    "strum": "Used by the studio's neck (the gap between strings in a strum); the engine ignores it."
  }
}
